# Required for real LLM-powered agents. Do not commit your actual .env file.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
DEMO_MODE=false

# Local SQLite audit log
APP_DB_PATH=data/runs.db
MAX_SOURCE_CHARS=14000

# Optional SMTP setup for the human-approved email action
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_smtp_or_app_password
SMTP_FROM=your_email@example.com
